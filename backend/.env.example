# Multi-Agent Lead Generation System Environment Config Template
DATABASE_URL=sqlite+aiosqlite:///./leadgen.db
APP_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated (localhost & private IPs are allowed by default)
CORS_ORIGINS=

# LLM Configuration: groq, ollama, openrouter, openai, mock
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_TO_MOCK=true

# Scheduler Settings
SCHEDULER_ENABLED=true
SCHEDULE_INTERVAL_HOURS=6

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=25000
MAX_SCRAPED_PER_RUN=10

# Human Review Settings
SENDER_NAME=Your Name / Team
