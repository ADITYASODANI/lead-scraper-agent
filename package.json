{
  "name": "multi-agent-lead-gen",
  "version": "1.0.0",
  "description": "Multi-Agent Business Lead Discovery & Website Proposal System – Phase 1 MVP",
  "private": true,
  "scripts": {
    "install:fe": "npm install --prefix frontend",
    "install:be": "echo 'Python venv packages already installed via pip'",
    "postinstall": "npm run install:fe",
    "start": "concurrently --kill-others --prefix-colors \"bgBlue.bold,bgGreen.bold\" --names \"BACKEND,FRONTEND\" \"npm run start:be\" \"npm run start:fe\"",
    "start:be": "cd backend && ../.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start:fe": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173",
    "dev": "npm start",
    "test": ".venv/bin/pytest tests/ -v --tb=short",
    "stop": "lsof -ti:8000,5173 | xargs kill -9 2>/dev/null; echo Done"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
